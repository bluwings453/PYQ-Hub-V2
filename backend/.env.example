# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB connection string - same one you already have working
MONGO_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/pyqhub?appName=Cluster0

# Port the API server listens on
PORT=5000

# Secret used to sign admin session tokens - use a long random string
JWT_SECRET=change_this_to_a_long_random_string

# Password for the single admin/moderator login
ADMIN_PASSWORD=change_this_password

# Comma-separated list of origins allowed to call this API
CLIENT_ORIGIN=http://localhost:5173
