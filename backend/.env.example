# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB connection string - same one you already have working
MONGO_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/pyqhub?appName=Cluster0

# Port the API server listens on
PORT=5000

# Secret used to sign admin session tokens - use a long random string
JWT_SECRET=change_this_to_a_long_random_string

# Password for the single admin/moderator login
ADMIN_PASSWORD=change_this_password

# Cloudinary - free account at cloudinary.com (no card needed). Papers are
# stored here, not on the server's own disk, so they survive redeploys and
# free-tier spin-downs. Find these three under your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Comma-separated list of origins allowed to call this API
CLIENT_ORIGIN=http://localhost:5173
